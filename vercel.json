{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/hero.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/logo-96.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; connect-src 'self' https://db.phinehasadams.com https://*.supabase.co https://www.google-analytics.com https://www.googletagmanager.com https://challenges.cloudflare.com; img-src 'self' data: https: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' https: data:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    },
    {
      "source": "/blog/:path*",
      "destination": "/"
    },
    {
      "source": "/jobs/:path*",
      "destination": "/"
    },
    {
      "source": "/guides/:path*",
      "destination": "/"
    },
    {
      "source": "/services/:path*",
      "destination": "/"
    },
    {
      "source": "/sports-court-coating/:path*",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/services/concrete-contractors",
      "destination": "https://www.concretewaco.com/contractors-in-waco-tx",
      "permanent": true
    },
    {
      "source": "/services/concrete-driveways",
      "destination": "https://www.concretewaco.com/concrete-driveways-waco-tx",
      "permanent": true
    },
    {
      "source": "/services/concrete-patios",
      "destination": "https://www.concretewaco.com/concrete-patios-waco-tx",
      "permanent": true
    },
    {
      "source": "/services/parking-lots",
      "destination": "https://www.concretewaco.com/parking-lot-concrete-waco",
      "permanent": true
    },
    {
      "source": "/services/concrete-repair",
      "destination": "https://www.concretewaco.com/foundation-repair-waco-tx",
      "permanent": true
    },
    {
      "source": "/services/concrete-demolition",
      "destination": "https://www.concretewaco.com/concrete-demolition-waco-tx",
      "permanent": true
    },
    {
      "source": "/services/concrete-sawing",
      "destination": "https://www.concretewaco.com/concrete-sawing-waco-tx",
      "permanent": true
    },
    {
      "source": "/services/sidewalks-driveways",
      "destination": "https://www.concretewaco.com/concrete-sidewalks-waco-tx",
      "permanent": true
    },
    {
      "source": "/services/stamped-concrete",
      "destination": "https://www.concretewaco.com/stamped-concrete-waco-tx",
      "permanent": true
    },
    {
      "source": "/services/commercial-concrete",
      "destination": "https://www.concretewaco.com/commercial-concrete-contractor-waco-tx",
      "permanent": true
    },
    {
      "source": "/services/concrete-foundations",
      "destination": "https://www.concretewaco.com/concrete-foundations-waco-tx",
      "permanent": true
    },
    {
      "source": "/concrete-repair-waco-tx",
      "destination": "https://www.concretewaco.com/foundation-repair-waco-tx",
      "permanent": true
    },
    {
      "source": "/concrete-parking-lots-waco-tx",
      "destination": "https://www.concretewaco.com/parking-lot-concrete-waco",
      "permanent": true
    },
    {
      "source": "/house-leveling-waco-tx",
      "destination": "https://www.concretewaco.com/foundation-repair-waco-tx",
      "permanent": true
    },
    {
      "source": "/general-contractor-waco-tx",
      "destination": "https://www.concretewaco.com/contractors-in-waco-tx",
      "permanent": true
    },
    {
      "source": "/wp-sitemap.xml",
      "destination": "https://www.concretewaco.com/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/wp-sitemap-posts-page-1.xml",
      "destination": "https://www.concretewaco.com/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "https://www.concretewaco.com/jobs",
      "permanent": true
    },
    {
      "source": "/gallery/",
      "destination": "https://www.concretewaco.com/jobs",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://www.concretewaco.com/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "concretewaco.com"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/blog-generate-worker",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/blog-album-sync",
      "schedule": "0 3 * * *"
    }
  ]
}
